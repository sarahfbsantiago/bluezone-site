rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Administradores: documento cujo id é o e-mail (criado só pelo console/CLI). Cada um lê apenas o próprio.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }
    match /admins/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
      allow write: if false;
    }
    // Editores: convidados por administradores pelo painel. Publicam notícias; não veem leads nem gerenciam pessoas.
    function isEditor() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/editors/$(request.auth.token.email));
    }
    function isStaff() { return isAdmin() || isEditor(); }
    match /editors/{email} {
      allow read: if isAdmin() || (request.auth != null && request.auth.token.email == email);
      allow create: if isAdmin()
        && email.matches('^[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}$')
        && request.resource.data.keys().hasOnly(['name', 'invitedBy', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.invitedBy == request.auth.token.email;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Notícias da BlueNews: leitura pública do que está publicado; escrita só por administradores, com limites.
    function validPost(d) {
      return d.keys().hasAll(['title', 'slug', 'category', 'excerpt', 'content', 'coverUrl', 'author', 'status', 'updatedAt'])
        && d.title is string && d.title.size() >= 3 && d.title.size() <= 140
        && d.slug is string && d.slug.size() >= 1 && d.slug.size() <= 80 && d.slug.matches('^[a-z0-9-]+$')
        && d.category is string && d.category.size() <= 40
        && d.excerpt is string && d.excerpt.size() <= 300
        && d.content is string && d.content.size() >= 20 && d.content.size() <= 20000
        && d.coverUrl is string && d.coverUrl.size() <= 500 && (d.coverUrl == '' || d.coverUrl.matches('^https://.*') || d.coverUrl.matches('^img:[A-Za-z0-9_-]+$'))
        && d.author is string && d.author.size() <= 80
        && d.status in ['draft', 'published'];
    }
    match /posts/{postId} {
      allow read: if resource.data.status == 'published' || isStaff();
      allow create: if isStaff() && validPost(request.resource.data);
      allow update: if isStaff() && validPost(request.resource.data);
      allow delete: if isAdmin();
    }

    // Imagens das notícias (data URL reduzida no navegador, ≤ 700 KB): leitura pública, envio/exclusão só por administradores.
    match /images/{imageId} {
      allow read: if true;
      allow create: if isStaff()
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 700000
        && request.resource.data.data.matches('^data:image/(webp|jpeg|png);base64,.*');
      allow update: if false;
      allow delete: if isStaff();
    }

    // Tudo o mais: negado (leads, events, users etc. entram nas próximas etapas, sempre via backend).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
