# URL do Web App do Google Apps Script que recebe o formulário de contato (ver apps-script/README.md)
VITE_CONTACT_ENDPOINT=
# URL pública do site, sem barra no fim (usada nas tags de prévia do WhatsApp/Instagram)
VITE_SITE_URL=https://abluezone.com.br
# index,follow em producao; noindex,nofollow no site de teste
VITE_ROBOTS=index,follow
