{
  "name": "bluezone-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node tests/smoke.mjs",
    "deploy": "VITE_SITE_URL=https://abluezone.com.br VITE_ROBOTS=index,follow vite build && firebase deploy --only hosting:prod",
    "deploy:teste": "VITE_SITE_URL=https://bluezone-teste.web.app VITE_ROBOTS=noindex,nofollow vite build && firebase deploy --only hosting:teste"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "^0.181.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "puppeteer": "^24.39.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
